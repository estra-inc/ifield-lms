                          "name": "codeLine1",
                          "fill": "#94A3B8",
                          "content": "/* 要素セレクタ */",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "QHN6n",
                          "name": "codeLine2",
                          "fill": "#E2E8F0",
                          "content": "p { color: #333; }",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 13,
                          "fontWeight": "normal"
